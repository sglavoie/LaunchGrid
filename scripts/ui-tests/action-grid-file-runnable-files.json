{
  "name": "Files that run something when opened, or open with an app that isn't theirs, are listed for review and left out by Remove Them, with the pages they empty",
  "fixture": {
    "rows": 3,
    "columns": 4,
    "pages": [
      [
        "Delta"
      ]
    ],
    "pageTitles": [
      ""
    ],
    "folders": {},
    "files": {
      "shared.launchgrid": "{\"version\": 2, \"rows\": 3, \"columns\": 4, \"pages\": [{\"items\": [{\"type\": \"action\", \"action\": {\"name\": \"Notes\", \"kind\": {\"type\": \"openFile\", \"path\": \"${FILES}/Notes.command\"}}}, {\"type\": \"action\", \"action\": {\"name\": \"Readme\", \"kind\": {\"type\": \"openFile\", \"path\": \"${FILES}/readme.txt\"}}}, {\"type\": \"action\", \"action\": {\"name\": \"In Terminal\", \"kind\": {\"type\": \"openFile\", \"path\": \"${FILES}/readme.txt\", \"appPath\": \"/System/Applications/Utilities/Terminal.app\"}}}, {\"type\": \"action\", \"action\": {\"name\": \"Setup\", \"kind\": {\"type\": \"openFile\", \"path\": \"${FILES}/setup.sh\"}}}, {\"type\": \"action\", \"action\": {\"name\": \"With Payload\", \"kind\": {\"type\": \"openFile\", \"path\": \"${FILES}/readme.txt\", \"appPath\": \"${FILES}/Payload.app\"}}}, {\"type\": \"action\", \"action\": {\"name\": \"In TextEdit\", \"kind\": {\"type\": \"openFile\", \"path\": \"${FILES}/readme.txt\", \"appPath\": \"/System/Applications/TextEdit.app\"}}}]}, {\"items\": [{\"type\": \"action\", \"action\": {\"name\": \"Wipe\", \"kind\": {\"type\": \"shell\", \"command\": \"touch ${FILES}/wiped\"}}}]}]}\n",
      "readme.txt": "Plain text.\n",
      "Notes.command": "touch \"$(dirname \"$0\")/ran\"\n",
      "setup.sh": "touch \"$(dirname \"$0\")/ran\"\n"
    }
  },
  "steps": [
    {
      "run": "show"
    },
    {
      "expect": {
        "keyWindow": true,
        "pagerReady": true
      }
    },
    {
      "run": "replacelayout:yes"
    },
    {
      "run": "review:remove"
    },
    {
      "run": "open:${FILES}/shared.launchgrid"
    },
    {
      "expect": {
        "pages": [
          [
            "Readme",
            "In TextEdit"
          ]
        ],
        "reviewActions": [
          "In TextEdit",
          "Readme"
        ]
      }
    },
    {
      "run": "review:keep"
    },
    {
      "run": "open:${FILES}/shared.launchgrid"
    },
    {
      "expect": {
        "pages": [
          [
            "Notes",
            "Readme",
            "In Terminal",
            "Setup",
            "With Payload",
            "In TextEdit"
          ],
          [
            "Wipe"
          ]
        ],
        "reviewActions": [
          "In Terminal",
          "In TextEdit",
          "Notes",
          "Readme",
          "Setup",
          "Wipe",
          "With Payload"
        ]
      }
    },
    {
      "run": "runaction:Notes"
    },
    {
      "expect": {
        "actionEditor": "edit:Notes"
      }
    }
  ]
}
