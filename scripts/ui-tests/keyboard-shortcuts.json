{
  "name": "⌘/, the ⋯ menu and search open the Keyboard Shortcuts panel; the ⌘ strip follows the context",
  "fixture": {
    "rows": 3, "columns": 4,
    "pages": [["Tools", "Delta", "Shortcuts"], ["Echo"]],
    "pageTitles": ["First", "Second"],
    "folders": {"Tools": ["Alpha", "Beta"]}
  },
  "steps": [
    {"run": "show"},
    {"expect": {"keyWindow": true, "pagerReady": true, "shortcutsShown": false}},
    {"run": "keys:cmd+/@44"},
    {"expect": {"shortcutsShown": true}},
    {"run": "keys:d,e"},
    {"expect": {"shortcutsShown": true, "query": ""}},
    {"run": "keys:cmd+e@14"},
    {"expect": {"shortcutsShown": true, "editing": false}},
    {"run": "keys:53"},
    {"expect": {"shortcutsShown": false, "shown": true}},
    {"run": "keys:cmd+/@44"},
    {"expect": {"shortcutsShown": true}},
    {"run": "keys:cmd+/@44"},
    {"expect": {"shortcutsShown": false, "shown": true}},

    {"run": "pagemenuhold"},
    {"expect": {"menuKeys": {"Edit Layout": "⌘E", "Undo": "⌘Z", "Redo": "⇧⌘Z", "New Page": "⌘N", "Keyboard Shortcuts": "⌘/", "Settings…": "⌘,"}}},
    {"run": "menurun:Keyboard Shortcuts"},
    {"expect": {"shortcutsShown": true}},
    {"run": "keys:36"},
    {"expect": {"shortcutsShown": false}},

    {"run": "keys:s,h,o,r,t,c"},
    {"expect": {"query": "shortc", "searchResults": ["Shortcuts", "Keyboard Shortcuts", "Keyboard"]}},
    {"run": "keys:125"},
    {"expect": {"focus": "Keyboard Shortcuts"}},
    {"run": "keys:36"},
    {"expect": {"shortcutsShown": true, "query": "shortc"}},
    {"run": "keys:53"},
    {"expect": {"shortcutsShown": false, "query": "shortc"}},
    {"run": "cmdheld"},
    {"expect": {"strip": ["openResult", "showInFinder", "quickLook", "clearSearch", "itemMenu", "shortcuts"]}},
    {"run": "keys:53"},
    {"expect": {"query": "", "strip": []}},

    {"run": "cmdheld"},
    {"expect": {"strip": ["goToPage", "turnPage", "edit", "showInFinder", "quickLook", "quitApp", "newPage", "selectAll", "undo", "itemMenu", "settings", "shortcuts"]}},
    {"run": "keys:cmd+e@14"},
    {"run": "cmdheld"},
    {"expect": {"editing": true, "strip": ["moveItem", "rename", "removeItem", "toggleSelect", "group", "editAction", "newPage", "undo", "doneEditing", "shortcuts"]}},
    {"run": "keys:53"},
    {"run": "focus:1"},
    {"run": "keys: @49"},
    {"run": "cmdheld"},
    {"expect": {"editing": false, "selection": ["Delta"], "strip": ["group", "removeSelection", "toggleSelect", "selectAll", "clearSelection", "undo", "shortcuts"]}},
    {"run": "keys:53"},
    {"run": "click:0"},
    {"run": "cmdheld"},
    {"expect": {"folder": "Tools", "selection": [], "strip": ["goToPage", "edit", "showInFinder", "quickLook", "quitApp", "undo", "itemMenu", "shortcuts"]}},
    {"run": "keys:cmd+/@44"},
    {"expect": {"shortcutsShown": true, "strip": [], "folder": "Tools"}},
    {"run": "keys:53"},
    {"expect": {"shortcutsShown": false, "folder": "Tools"}},
    {"run": "hide"},
    {"expect": {"shown": false}},
    {"run": "show"},
    {"expect": {"shortcutsShown": false, "shown": true}}
  ]
}
