{
  "name": "Create, find, edit, undo and hide an action through the action editor",
  "fixture": {
    "rows": 3, "columns": 4,
    "pages": [["Alpha", "Beta"], ["Gamma"]],
    "pageTitles": ["", ""],
    "folders": {},
    "actions": [
      {"name": "Search GitHub", "keywords": ["gh"], "showsOnGrid": false,
       "kind": {"type": "openURL", "template": "https://github.com/search?q={query}"}}
    ]
  },
  "steps": [
    {"run": "show"},
    {"expect": {"keyWindow": true, "pagerReady": true}},
    {"run": "page:1"},
    {"expect": {"currentPage": 1}},
    {"run": "pagemenuhold"},
    {"run": "menurun:New Action…"},
    {"expect": {"actionEditor": "new", "shown": false}},
    {"run": "editorfill:keywords=gh, two words"},
    {"expect": {"editorErrors": ["Enter a name.", "Enter a link.", "Keywords can't contain spaces: “two words”"], "editorWarnings": ["“gh” is also a keyword of Search GitHub."]}},
    {"run": "editorcancel"},
    {"expect": {"actionEditor": "", "pages": [["Alpha", "Beta"], ["Gamma"]], "hiddenActions": ["Search GitHub"]}},
    {"run": "show"},
    {"expect": {"keyWindow": true}},
    {"run": "pagemenuhold"},
    {"run": "menurun:New Action…"},
    {"expect": {"actionEditor": "new"}},
    {"run": "editorfill:name=Docs Search"},
    {"run": "editorfill:template=https://example.com/?q={query}"},
    {"run": "editorfill:keywords=ds"},
    {"expect": {"editorErrors": [], "editorWarnings": []}},
    {"run": "editorsave"},
    {"expect": {"actionEditor": "", "pages": [["Alpha", "Beta"], ["Gamma", "Docs Search"]],
                "actions": {"Search GitHub": ["gh"], "Docs Search": ["ds"]}}},
    {"run": "show"},
    {"expect": {"keyWindow": true}},
    {"run": "keys:d,s, @49,d,o,c,s"},
    {"expect": {"query": "ds docs", "searchResults": ["Docs Search"], "searchArguments": ["docs"]}},
    {"run": "keys:53"},
    {"expect": {"query": ""}},
    {"run": "page:1"},
    {"run": "focus:1"},
    {"run": "keys:cmd+i@34"},
    {"expect": {"actionEditor": "edit:Docs Search", "shown": false}},
    {"run": "editorfill:keywords=dz"},
    {"run": "editorsave"},
    {"expect": {"actionEditor": "", "actions": {"Search GitHub": ["gh"], "Docs Search": ["dz"]}}},
    {"run": "undo"},
    {"expect": {"actions": {"Search GitHub": ["gh"], "Docs Search": ["ds"]}, "pages": [["Alpha", "Beta"], ["Gamma", "Docs Search"]]}},
    {"run": "show"},
    {"expect": {"keyWindow": true}},
    {"run": "page:1"},
    {"run": "edit"},
    {"run": "focus:1"},
    {"run": "keys:36"},
    {"expect": {"actionEditor": "edit:Docs Search"}},
    {"run": "editorfill:showongrid=false"},
    {"run": "editorsave"},
    {"expect": {"actionEditor": "", "pages": [["Alpha", "Beta"], ["Gamma"]], "hiddenActions": ["Search GitHub", "Docs Search"]}},
    {"run": "show"},
    {"expect": {"keyWindow": true}},
    {"run": "search:ds"},
    {"expect": {"searchResults": ["Docs Search"], "pages": [["Alpha", "Beta"], ["Gamma"]]}},
    {"run": "undo"},
    {"expect": {"pages": [["Alpha", "Beta"], ["Gamma", "Docs Search"]], "hiddenActions": ["Search GitHub"]}}
  ]
}
