<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store build's App Sandbox. scripts/app-store.sh adds the team's identifiers. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Grid files saved and loaded, databases imported, folders, pictures and apps picked. -->
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <!-- Keeps the picked folders, pictures and apps across launches. -->
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
    <!-- ~/Applications, scanned for apps like /Applications. Explained in the review notes. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array><string>/Applications/</string></array>
</dict>
</plist>
